rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (request.auth.uid == '3d5K6bFJfnaI0ufavRADKZ3Dzwo2'
        || request.auth.token.admin == true);
    }

    match /siteContent/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}